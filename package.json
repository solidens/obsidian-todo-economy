{
  "name": "obsidian-todo-economy",
  "version": "1.4.2",
  "description": "Todo Economy — плагин Obsidian: баллы за задачи, награды по решённым ценам, ASCII-интерфейс",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/build-tests.mjs && node --test \"tests/*.test.mjs\"",
    "check": "npm run build && npm test"
  },
  "keywords": ["obsidian", "obsidian-plugin", "todo", "gamification", "ascii"],
  "author": "solidens",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.3"
  }
}
